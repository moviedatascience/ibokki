# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# test / coverage
coverage/

# logs
*.log
npm-debug.log*

# editor / os
.DS_Store
Thumbs.db
.vscode/
.idea/

# art working files (Krita drops autosaves next to the file being edited,
# including under apps/client/public — keep them out of the repo and the image)
*.kra
*.kra-autosave

# sim output
sim-reports/

# gc report output — the dated reports are regenerated each run, but gc-state.json
# is the tracked durable record (decisions + previous findings) so the weekly CI
# run can delta against last time and honour ignore decisions
interop/gc/*
!interop/gc/gc-state.json

# server database (SQLite + WAL sidecars) — root data/ only; package data
# (e.g. packages/sim/data/cast-priors.json) is version-controlled
/data/

# playtest session state (the .md logs ARE kept as artifacts)
playtests/.sessions/

# playwright output
test-results/
playwright-report/

# DSH multi-agent org — agent scratch state (the playbook, briefs, roster and
# presets ARE version-controlled under .dsh/)
.dsh/notes/
